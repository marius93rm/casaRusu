---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import OpeningStatus from './OpeningStatus.astro';
import RestaurantPhoto from './RestaurantPhoto.astro';
import { siteData, type SiteLocale } from '../data/site';
import { getDictionary, localizedPath } from '../i18n';
import { menuPages } from '../data/menu';

const { locale } = Astro.props as { locale: SiteLocale };
const copy = siteData.copy[locale];
const { ui } = getDictionary(locale);
const socialImage = {
  src: siteData.media.featuredDish,
  alt: copy.dish.imageAlt,
  width: 2048,
  height: 1366,
};
const menuHref = localizedPath('/meniu', locale);
const printedDishPage = menuPages.find((page) => page.id === 'porc');
const printedDish = printedDishPage?.sections.flatMap((section) => section.items)
  .find((item) => item.name === 'Șnițel din cotlet de porc cu os');

if (!printedDishPage || !printedDish) {
  throw new Error('The schnitzel listing must exist in the printed menu data.');
}

const seoDescription = copy.dish.seo.description
  .replace('{quantity}', printedDish.quantity)
  .replace('{price}', String(printedDish.price));
---

<BaseLayout
  lang={locale}
  title={copy.dish.seo.title}
  description={seoDescription}
  {socialImage}
  criticalImage={{ srcset: `${siteData.media.featuredDish} 2048w`, sizes: '100vw', type: 'image/jpeg' }}
>
  <a class="skip-link" href="#main-content">{ui.skipToContent}</a>
  <Header {locale} navigation={copy.nav} cta={{ label: copy.hero.primaryAction, href: siteData.company.phoneHref }} />

  <main id="main-content" tabindex="-1">
    <article class="dish-detail" aria-labelledby="dish-detail-title">
      <div class="container">
        <Breadcrumbs locale={locale} currentLabel={copy.dish.title} level="dish" />
        <OpeningStatus {locale} />
        <div class="dish-detail-grid">
          <figure class="dish-detail-visual">
            <RestaurantPhoto image={siteData.media.featuredDish} alt={copy.dish.imageAlt} eager />
          </figure>

          <div class="dish-detail-copy">
            <p class="section-label">{copy.dish.eyebrow}</p>
            <h1 id="dish-detail-title">{copy.dish.title}</h1>
            <p class="dish-detail-body">{copy.dish.body}</p>
            <aside class="dish-menu-listing" aria-labelledby="dish-menu-listing-title">
              <div class="dish-menu-listing-heading">
                <p class="section-label" id="dish-menu-listing-title">{copy.dish.menuListingLabel}</p>
                <p class="dish-menu-listing-price">
                  <span>{printedDish.quantity}</span>
                  <strong>{printedDish.price} lei</strong>
                </p>
              </div>
              <p class="dish-menu-listing-note">{copy.dish.menuListingNote}</p>
              <a class="text-link" href={`${menuHref}/#menu-page-${printedDishPage.id}`}>
                {copy.dish.menuListingAction}<Icon name="arrow" size={18} />
              </a>
            </aside>
            <div class="dish-detail-actions">
              <a class="button button-primary" href={siteData.company.phoneHref}>
                {copy.hero.primaryAction}<Icon name="phone" size={18} />
              </a>
              <a class="text-link" href={menuHref}>
                {copy.menu.backAction}<Icon name="arrow" size={18} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer {locale} />
  <aside class="mobile-booking" aria-label={ui.reservations}>
    <a class="mobile-booking-cta" href={siteData.company.phoneHref}>
      {copy.hero.primaryAction}<Icon name="phone" size={18} />
    </a>
  </aside>
</BaseLayout>
