---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { siteData, type SiteLocale } from '../data/site';
import { localizedPath } from '../i18n';
import { imageSizes, webpSrcset } from '../utils/responsiveImages';

const { locale } = Astro.props as { locale: SiteLocale };
const copy = siteData.copy[locale];
const menuHref = localizedPath('/meniu', locale);
---

<BaseLayout
  lang={locale}
  title={`${copy.dish.title} | Restaurant Casa Rusu`}
  description={copy.dish.body}
>
  <a class="skip-link" href="#main-content">{locale === 'ro' ? 'Sari la conținut' : 'Skip to content'}</a>
  <Header {locale} navigation={copy.nav} cta={{ label: copy.hero.primaryAction, href: siteData.company.phoneHref }} />

  <main id="main-content" tabindex="-1">
    <article class="dish-detail" aria-labelledby="dish-detail-title">
      <div class="container dish-detail-grid">
        <figure class="dish-detail-visual">
          <picture>
            <source
              type="image/webp"
              srcset={webpSrcset(siteData.media.featuredDish, [640, 960, 1280, 1600, 1920])}
              sizes={imageSizes}
            />
            <img
              src={siteData.media.featuredDish}
              alt={copy.dish.imageAlt}
              fetchpriority="high"
              width="2048"
              height="1366"
            />
          </picture>
        </figure>

        <div class="dish-detail-copy">
          <p class="section-label">{copy.dish.eyebrow}</p>
          <h1 id="dish-detail-title">{copy.dish.title}</h1>
          <p class="dish-detail-body">{copy.dish.body}</p>
          <p class="dish-detail-note">{copy.dish.note}</p>
          <div class="dish-detail-actions">
            <a class="button button-primary" href={siteData.company.phoneHref}>
              {copy.hero.primaryAction}<Icon name="phone" size={18} />
            </a>
            <a class="text-link" href={menuHref}>
              {copy.menu.backAction}<Icon name="arrow" size={18} />
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer {locale} />
  <a class="mobile-booking-cta" href={siteData.company.phoneHref}>
    {copy.hero.primaryAction}<Icon name="phone" size={18} />
  </a>
</BaseLayout>
