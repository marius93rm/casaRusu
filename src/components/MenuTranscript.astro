---
import { menuPages, menuCopy } from '../data/menu';
import { localizedMenuItem } from '../i18n/menu';
import type { SiteLocale } from '../data/site';
import Icon from './Icon.astro';

const { locale } = Astro.props as { locale: SiteLocale };
const copy = menuCopy[locale];
const maximumMenuPrice = Math.max(...menuPages.flatMap((page) => page.sections.flatMap((section) => section.items.map((item) => item.price))));
---

<section class="menu-transcript" id="read-menu" aria-labelledby="menu-transcript-title">
  <header class="menu-transcript-heading">
    <p class="eyebrow">{copy.read}</p>
    <h2 id="menu-transcript-title">{copy.readTitle}</h2>
    <p>{copy.readBody}</p>
    <p class="menu-language-note">{copy.languageNote}</p>
    <button class="button button-outline menu-print-action" type="button" data-menu-print hidden>{copy.printMenu}</button>
  </header>
  <search
    class="menu-search"
    aria-label={copy.searchLandmark}
    data-search-no-results={copy.searchNoResults}
    data-search-one-result={copy.searchOneResult}
    data-search-many-results={copy.searchManyResults}
    data-price-limit-all={copy.priceLimitAll}
    data-price-limit-up-to={copy.priceLimitUpTo}
    data-category-all={copy.categoryAll}
    data-sort-menu-order={copy.sortMenuOrder}
    data-search-share-label={copy.searchShare}
    data-search-share-native-label={copy.searchShareNative}
    data-search-share-copied={copy.searchShareCopied}
    data-search-share-done={copy.searchShareDone}
    data-search-share-failed={copy.searchShareFailed}
    hidden
    data-menu-search
  >
    <label for="menu-dish-search">{copy.searchLabel}</label>
    <input
      id="menu-dish-search"
      type="search"
      placeholder={copy.searchPlaceholder}
      aria-describedby="menu-search-hint"
      aria-controls="menu-transcript-pages"
      data-menu-search-input
    />
    <p class="visually-hidden" id="menu-search-hint">{copy.searchHint}</p>
    <details class="menu-category-filter" data-menu-category-filter-details>
      <summary>
        <span>{copy.categoryFilter}</span>
        <output for="menu-category-filter" data-menu-category-filter-output>{copy.categoryAll}</output>
      </summary>
      <label class="visually-hidden" for="menu-category-filter">{copy.categoryFilter}</label>
      <select id="menu-category-filter" data-menu-category-filter aria-describedby="menu-search-hint">
        <option value="">{copy.categoryAll}</option>
        {menuPages.filter((page) => page.sections.length > 0).map((page) => (
          <optgroup label={page.title[locale]}>
            {page.sections.map((section, index) => <option value={`${page.id}-${index + 1}`} data-menu-category-option>{section.title[locale]}</option>)}
          </optgroup>
        ))}
      </select>
    </details>
    <details class="menu-price-filter" data-price-limit-filter>
      <summary>
        <span>{copy.priceLimit}</span>
        <output for="menu-price-limit" data-menu-price-limit-output>{copy.priceLimitAll}</output>
      </summary>
      <label class="visually-hidden" for="menu-price-limit">{copy.priceLimit}</label>
      <input
        id="menu-price-limit"
        type="range"
        min="0"
        max={maximumMenuPrice}
        step="1"
        value={maximumMenuPrice}
        aria-describedby="menu-search-hint"
        data-menu-price-limit
      />
    </details>
    <details class="menu-sort-filter" data-menu-sort-filter-details>
      <summary>
        <span>{copy.sortFilter}</span>
        <output for="menu-sort-order" data-menu-sort-output>{copy.sortMenuOrder}</output>
      </summary>
      <label class="visually-hidden" for="menu-sort-order">{copy.sortFilter}</label>
      <select id="menu-sort-order" data-menu-sort-filter aria-describedby="menu-search-hint">
        <option value="menu">{copy.sortMenuOrder}</option>
        <option value="price-asc">{copy.sortPriceAsc}</option>
        <option value="price-desc">{copy.sortPriceDesc}</option>
      </select>
    </details>
    <div class="menu-search-actions" data-menu-search-actions hidden>
      <button class="menu-search-share" type="button" data-menu-search-share hidden>{copy.searchShare}</button>
      <button class="menu-search-reset" type="button" data-menu-search-reset hidden>{copy.searchReset}</button>
    </div>
    <p class="menu-search-share-status" data-menu-search-share-status role="status" aria-live="polite" aria-atomic="true" hidden></p>
    <p class="menu-search-status" data-menu-search-status role="status" aria-live="polite" aria-atomic="true" hidden></p>
  </search>
  <div class="menu-transcript-pages" id="menu-transcript-pages">
    {menuPages.filter((page) => page.sections.length > 0).map((page) => (
      <details class="menu-transcript-page" id={`read-${page.id}`}>
        <summary>{page.title[locale]}</summary>
        <a class="text-link menu-transcript-page-scan" href={`#menu-page-${page.id}`}>
          {copy.scanPage}: {page.title[locale]}<Icon name="arrow" size={18} />
        </a>
        <div class="menu-transcript-sections">
          {page.sections.map((section, sectionIndex) => (
            <section class="menu-transcript-section" aria-label={section.title[locale]}>
              <h3 id={`menu-section-${page.id}-${sectionIndex + 1}`} data-menu-section tabindex="-1">{section.title[locale]}</h3>
              <ul lang={locale}>
                {section.items.map((original) => {
                  const item = localizedMenuItem(original, locale);
                  return (
                    <li data-menu-item data-menu-price={original.price} data-menu-category={`${page.id}-${sectionIndex + 1}`} data-menu-original={`${original.name} ${original.ingredients}`}>
                      <div class="menu-item-heading"><h4>{item.name}</h4><span class="menu-item-price">{item.price} lei</span></div>
                      {item.name !== original.name && <p class="menu-item-original" lang="ro">{original.name}</p>}
                      {item.ingredients && <p>{item.ingredients}</p>}
                      <span class="menu-item-quantity">{item.quantity}</span>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
        <a class="text-link menu-transcript-return" href="#menu-dish-search" data-menu-search-link hidden>{copy.searchReturn}</a>
      </details>
    ))}
  </div>
</section>

<script>
  import { menuCategoryQueryParam, menuPriceLimitQueryParam, menuSearchMatches, menuSearchQueryParam, menuSortQueryParam, normalizeMenuSearchText, parseMenuCategory, parseMenuPriceLimit, parseMenuSort, sortMenuItems, updateMenuSearchUrl } from '../utils/menuSearch.mjs';

  const search = document.querySelector<HTMLElement>('[data-menu-search]');
  if (search) {
    const input = search.querySelector<HTMLInputElement>('[data-menu-search-input]')!;
    const categoryFilter = search.querySelector<HTMLSelectElement>('[data-menu-category-filter]')!;
    const categoryFilterDetails = search.querySelector<HTMLDetailsElement>('[data-menu-category-filter-details]')!;
    const categoryFilterOutput = search.querySelector<HTMLOutputElement>('[data-menu-category-filter-output]')!;
    const priceLimit = search.querySelector<HTMLInputElement>('[data-menu-price-limit]')!;
    const priceLimitOutput = search.querySelector<HTMLOutputElement>('[data-menu-price-limit-output]')!;
    const priceLimitFilter = search.querySelector<HTMLDetailsElement>('[data-price-limit-filter]')!;
    const sortFilter = search.querySelector<HTMLSelectElement>('[data-menu-sort-filter]')!;
    const sortFilterDetails = search.querySelector<HTMLDetailsElement>('[data-menu-sort-filter-details]')!;
    const sortFilterOutput = search.querySelector<HTMLOutputElement>('[data-menu-sort-output]')!;
    const resetButton = search.querySelector<HTMLButtonElement>('[data-menu-search-reset]')!;
    const searchActions = search.querySelector<HTMLElement>('[data-menu-search-actions]')!;
    const shareButton = search.querySelector<HTMLButtonElement>('[data-menu-search-share]')!;
    const shareStatus = search.querySelector<HTMLElement>('[data-menu-search-share-status]')!;
    const printButton = document.querySelector<HTMLButtonElement>('[data-menu-print]');
    const status = search.querySelector<HTMLElement>('[data-menu-search-status]')!;
    const maximumMenuPrice = Number(priceLimit.max);
    const validCategories = new Set([...categoryFilter.options].map((option) => option.value).filter(Boolean));
    const pages = [...document.querySelectorAll<HTMLDetailsElement>('.menu-transcript-page')].map((page) => {
      const sections = [...page.querySelectorAll<HTMLElement>('.menu-transcript-section')].map((element) => ({
        element,
        list: element.querySelector<HTMLUListElement>('ul')!,
        items: [...element.querySelectorAll<HTMLElement>('[data-menu-item]')],
      }));
      return { page, sections, items: sections.flatMap(({ items }) => items) };
    });
    const initialUrl = new URL(window.location.href);
    const initialQuery = initialUrl.searchParams.get(menuSearchQueryParam);
    const initialCategory = parseMenuCategory(initialUrl.searchParams.get(menuCategoryQueryParam), validCategories);
    const initialPriceLimit = parseMenuPriceLimit(initialUrl.searchParams.get(menuPriceLimitQueryParam), maximumMenuPrice);
    const initialSort = parseMenuSort(initialUrl.searchParams.get(menuSortQueryParam));
    input.value = initialQuery ?? '';
    categoryFilter.value = initialCategory;
    categoryFilterDetails.open = Boolean(initialCategory);
    priceLimit.value = String(initialPriceLimit);
    priceLimitFilter.open = initialPriceLimit < maximumMenuPrice;
    sortFilter.value = initialSort;
    sortFilterDetails.open = initialSort !== 'menu';
    search.hidden = false;
    document.querySelectorAll<HTMLAnchorElement>('[data-menu-search-link]').forEach((link) => {
      link.hidden = false;
    });

    const updatePriceLimitLabel = () => {
      const currentLimit = Number(priceLimit.value);
      priceLimitOutput.textContent = currentLimit >= maximumMenuPrice
        ? search.dataset.priceLimitAll ?? ''
        : (search.dataset.priceLimitUpTo ?? '').replace('{price}', String(currentLimit));
      priceLimit.setAttribute('aria-valuetext', priceLimitOutput.textContent);
    };

    const updateCategoryFilterLabel = () => {
      categoryFilterOutput.textContent = categoryFilter.selectedOptions[0]?.textContent ?? search.dataset.categoryAll ?? '';
    };

    const updateSortFilterLabel = () => {
      sortFilterOutput.textContent = sortFilter.selectedOptions[0]?.textContent ?? search.dataset.sortMenuOrder ?? '';
    };

    const canShareCurrentUrl = () => {
      if (!window.isSecureContext || typeof navigator.share !== 'function') return false;
      if (typeof navigator.canShare !== 'function') return true;

      try {
        return navigator.canShare({ url: window.location.href });
      } catch {
        return false;
      }
    };

    const syncSearchUrl = () => {
      const currentUrl = window.location.href;
      const nextUrl = updateMenuSearchUrl(currentUrl, input.value, priceLimit.value, maximumMenuPrice, categoryFilter.value, sortFilter.value);
      if (nextUrl.href !== currentUrl) window.history.replaceState(window.history.state, '', nextUrl.href);
    };

    const updateResults = () => {
      const query = normalizeMenuSearchText(input.value.trim());
      const currentPriceLimit = Number(priceLimit.value);
      const selectedCategory = categoryFilter.value;
      const selectedSort = sortFilter.value;
      const filtersAreActive = Boolean(query) || currentPriceLimit < maximumMenuPrice || Boolean(selectedCategory) || selectedSort !== 'menu';
      let resultCount = 0;
      shareStatus.hidden = true;
      shareStatus.textContent = '';

      pages.forEach(({ page, items, sections }) => {
        let pageResultCount = 0;
        items.forEach((item) => {
          const section = item.closest('.menu-transcript-section');
          const sectionTitle = section?.querySelector('h3')?.textContent ?? '';
          const pageTitle = page.querySelector('summary')?.textContent ?? '';
          const priceMatches = Number(item.dataset.menuPrice) <= currentPriceLimit;
          const categoryMatches = !selectedCategory || item.dataset.menuCategory === selectedCategory;
          const textMatches = menuSearchMatches(query, `${item.textContent} ${item.dataset.menuOriginal ?? ''} ${sectionTitle} ${pageTitle}`);
          const matches = priceMatches && categoryMatches && textMatches;
          item.hidden = !matches;
          if (matches) {
            pageResultCount += 1;
            resultCount += 1;
          }
        });

        sections.forEach(({ element, list, items: sectionItems }) => {
          list.append(...sortMenuItems(sectionItems, selectedSort));
          element.hidden = !sectionItems.some((item) => !item.hidden);
        });

        if (filtersAreActive) {
          page.hidden = pageResultCount === 0;
          page.open = pageResultCount > 0;
        } else {
          page.hidden = false;
          page.open = false;
        }
      });

      status.hidden = !filtersAreActive;
      searchActions.hidden = !filtersAreActive;
      resetButton.hidden = !filtersAreActive;
      const nativeShareAvailable = canShareCurrentUrl();
      const copyAvailable = window.isSecureContext && typeof navigator.clipboard?.writeText === 'function';
      shareButton.hidden = !filtersAreActive || (!nativeShareAvailable && !copyAvailable);
      shareButton.textContent = nativeShareAvailable
        ? search.dataset.searchShareNativeLabel ?? ''
        : search.dataset.searchShareLabel ?? '';
      if (!filtersAreActive) {
        status.textContent = '';
      } else if (resultCount === 0) {
        status.textContent = search.dataset.searchNoResults ?? '';
      } else if (resultCount === 1) {
        status.textContent = search.dataset.searchOneResult ?? '';
      } else {
        status.textContent = (search.dataset.searchManyResults ?? '').replace('{count}', String(resultCount));
      }
    };

    if (printButton) {
      let printState: {
        query: string;
        category: string;
        categoryFilterOpen: boolean;
        priceLimit: string;
        priceFilterOpen: boolean;
        sort: string;
        sortFilterOpen: boolean;
        pagesOpen: boolean[];
      } | null = null;

      printButton.hidden = false;
      printButton.addEventListener('click', () => window.print());
      window.addEventListener('beforeprint', () => {
        if (!printState) {
          printState = {
            query: input.value,
            category: categoryFilter.value,
            categoryFilterOpen: categoryFilterDetails.open,
            priceLimit: priceLimit.value,
            priceFilterOpen: priceLimitFilter.open,
            sort: sortFilter.value,
            sortFilterOpen: sortFilterDetails.open,
            pagesOpen: pages.map(({ page }) => page.open),
          };
        }

        input.value = '';
        categoryFilter.value = '';
        categoryFilterDetails.open = false;
        updateCategoryFilterLabel();
        priceLimit.value = String(maximumMenuPrice);
        priceLimitFilter.open = false;
        updatePriceLimitLabel();
        sortFilter.value = 'menu';
        sortFilterDetails.open = false;
        updateSortFilterLabel();
        updateResults();
        pages.forEach(({ page }) => {
          page.hidden = false;
          page.open = true;
        });
      });
      window.addEventListener('afterprint', () => {
        if (!printState) return;

        const previousState = printState;
        printState = null;
        input.value = previousState.query;
        categoryFilter.value = previousState.category;
        categoryFilterDetails.open = previousState.categoryFilterOpen;
        updateCategoryFilterLabel();
        priceLimit.value = previousState.priceLimit;
        priceLimitFilter.open = previousState.priceFilterOpen;
        updatePriceLimitLabel();
        sortFilter.value = previousState.sort;
        sortFilterDetails.open = previousState.sortFilterOpen;
        updateSortFilterLabel();
        updateResults();
        pages.forEach(({ page }, index) => {
          page.open = previousState.pagesOpen[index];
        });
        syncSearchUrl();
      });
    }

    input.addEventListener('input', () => {
      syncSearchUrl();
      updateResults();
    });
    categoryFilter.addEventListener('change', () => {
      updateCategoryFilterLabel();
      syncSearchUrl();
      updateResults();
    });
    priceLimit.addEventListener('input', () => {
      updatePriceLimitLabel();
      syncSearchUrl();
      updateResults();
    });
    sortFilter.addEventListener('change', () => {
      updateSortFilterLabel();
      syncSearchUrl();
      updateResults();
    });
    resetButton.addEventListener('click', () => {
      input.value = '';
      categoryFilter.value = '';
      categoryFilterDetails.open = false;
      updateCategoryFilterLabel();
      priceLimit.value = String(maximumMenuPrice);
      priceLimitFilter.open = false;
      updatePriceLimitLabel();
      sortFilter.value = 'menu';
      sortFilterDetails.open = false;
      updateSortFilterLabel();
      syncSearchUrl();
      updateResults();
      input.focus({ preventScroll: true });
    });
    shareButton.addEventListener('click', async () => {
      shareStatus.hidden = true;
      shareStatus.textContent = '';
      const shareUrl = window.location.href;

      if (canShareCurrentUrl()) {
        try {
          await navigator.share({ title: document.title, url: shareUrl });
          shareStatus.textContent = search.dataset.searchShareDone ?? '';
          shareStatus.hidden = false;
          return;
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
        }
      }

      try {
        if (!window.isSecureContext || typeof navigator.clipboard?.writeText !== 'function') throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(shareUrl);
        shareStatus.textContent = search.dataset.searchShareCopied ?? '';
      } catch {
        shareStatus.textContent = search.dataset.searchShareFailed ?? '';
      }
      shareStatus.hidden = false;
    });

    updatePriceLimitLabel();
    updateCategoryFilterLabel();
    updateSortFilterLabel();
    syncSearchUrl();
    updateResults();
    if ((initialQuery?.trim() || initialCategory || initialPriceLimit < maximumMenuPrice || initialSort !== 'menu') && !window.location.hash) {
      search.scrollIntoView({ block: 'start' });
    }
  }
</script>
