---
import {
  IconArrowRight,
  IconArrowUpRight,
  IconBrandFacebook,
  IconBrandInstagram,
  IconBrandTiktok,
  IconChevronRight,
  IconChevronLeft,
  IconZoomIn,
  IconZoomOut,
  IconArrowsMinimize,
  IconMapPin,
  IconMenu2,
  IconPhone,
  IconX,
} from '@tabler/icons-astro';

type IconName =
  | 'arrow'
  | 'diagonal'
  | 'close'
  | 'menu'
  | 'chevron'
  | 'previous'
  | 'zoom-in'
  | 'zoom-out'
  | 'fit'
  | 'phone'
  | 'instagram'
  | 'tiktok'
  | 'facebook'
  | 'location';

interface Props {
  name?: IconName;
  class?: string;
  size?: number;
}

const { name = 'arrow', class: className, size = 20 } = Astro.props;

const icons = {
  arrow: IconArrowRight,
  diagonal: IconArrowUpRight,
  close: IconX,
  menu: IconMenu2,
  chevron: IconChevronRight,
  previous: IconChevronLeft,
  'zoom-in': IconZoomIn,
  'zoom-out': IconZoomOut,
  fit: IconArrowsMinimize,
  phone: IconPhone,
  instagram: IconBrandInstagram,
  tiktok: IconBrandTiktok,
  facebook: IconBrandFacebook,
  location: IconMapPin,
} as const;

const IconComponent = icons[name];
---

<IconComponent class={className} {size} stroke={1.5} aria-hidden="true" />
