---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { siteData, type SiteLocale } from '../data/site';
import { localizedPath } from '../i18n';
import { imageSizes, webpSrcset } from '../utils/responsiveImages';
import { formatOpeningHours } from '../utils/openingHours';

const { locale } = Astro.props as { locale: SiteLocale };
const copy = siteData.copy[locale];
const seo = siteData.seo[locale];
const socialImage = {
  src: siteData.media.cover,
  alt: copy.hero.imageAlt,
  width: 2048,
  height: 1366,
};
const dishHref = localizedPath('/preparate/snitel-cotlet-porc', locale);
const openingHours = formatOpeningHours(siteData.company.openingHours, locale);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: siteData.company.name,
  telephone: siteData.company.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteData.company.address,
    addressLocality: siteData.company.city,
    postalCode: siteData.company.postalCode,
    addressCountry: 'RO',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteData.company.geo.latitude,
    longitude: siteData.company.geo.longitude,
  },
  openingHoursSpecification: siteData.company.openingHours.map((hours) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: hours.daysOfWeek.map((day) => `https://schema.org/${day}`),
    opens: hours.opens,
    closes: hours.closes,
  })),
  sameAs: [siteData.links.facebook, siteData.links.instagram],
  ...(Astro.site ? {
    '@id': new URL('/#restaurant', Astro.site).toString(),
    url: new URL('/', Astro.site).toString(),
    image: [siteData.media.cover, siteData.media.exterior, siteData.media.featuredDish]
      .map((image) => new URL(image, Astro.site).toString()),
    logo: new URL(siteData.media.logo, Astro.site).toString(),
  } : {}),
};
---

<BaseLayout lang={locale} title={seo.title} description={seo.description} {socialImage}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <a class="skip-link" href="#main-content">{locale === 'ro' ? 'Sari la conținut' : 'Skip to content'}</a>
  <Header {locale} navigation={copy.nav} cta={{ label: copy.hero.primaryAction, href: siteData.company.phoneHref }} />

  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-stage">
        <div class="hero-copy">
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <h1 id="hero-title">{copy.hero.title}</h1>
          <p class="hero-slogan">{copy.hero.slogan}</p>
          <p class="hero-description">{copy.hero.description}</p>
          <div class="hero-actions">
            <a class="button button-primary" href={siteData.company.phoneHref}>
              {copy.hero.primaryAction}<Icon name="phone" size={18} />
            </a>
            <a class="text-link" href="#vizita">{copy.hero.secondaryAction}<Icon name="diagonal" size={17} /></a>
          </div>
        </div>

        <figure class="hero-visual">
          <picture>
            <source
              type="image/webp"
              srcset={webpSrcset(siteData.media.cover, [640, 960, 1280, 1600, 1920])}
              sizes={imageSizes}
            />
            <img
              src={siteData.media.cover}
              alt={copy.hero.imageAlt}
              fetchpriority="high"
              width="1919"
              height="1279"
            />
          </picture>
        </figure>
      </div>
    </section>

    <section class="story-section" id="poveste" aria-labelledby="story-title">
      <div class="container story-inner">
        <h2 id="story-title">{copy.story.title}</h2>
        <p class="story-body">{copy.story.body}</p>
        <a class="text-link story-link" href="#preparat">{copy.dish.eyebrow}<Icon name="arrow" size={18} /></a>
      </div>
    </section>

    <section class="dish-section" id="preparat" aria-labelledby="dish-title">
      <div class="container dish-grid">
        <figure class="dish-visual">
          <picture>
            <source
              type="image/webp"
              srcset={webpSrcset(siteData.media.featuredDish, [640, 960, 1280, 1600, 1920])}
              sizes={imageSizes}
            />
            <img
              src={siteData.media.featuredDish}
              alt={copy.dish.imageAlt}
              loading="lazy"
              width="2048"
              height="1366"
            />
          </picture>
        </figure>
        <div class="dish-copy">
          <p class="section-label">{copy.dish.eyebrow}</p>
          <h2 id="dish-title">{copy.dish.title}</h2>
          <p>{copy.dish.body}</p>
          <small>{copy.dish.note}</small>
          <a class="text-link" href={dishHref}>
            {copy.dish.action}<Icon name="diagonal" size={17} />
          </a>
        </div>
      </div>
    </section>

    <section class="visit-section" id="vizita" aria-labelledby="visit-title">
      <div class="container visit-layout">
        <div class="visit-heading">
          <h2 id="visit-title">{copy.visit.titleFirst}{' '}<span>{copy.visit.titleSecond}</span></h2>
          <p>{copy.visit.body}</p>
        </div>
        <figure class="visit-visual">
          <picture>
            <source
              type="image/webp"
              srcset={webpSrcset(siteData.media.exterior, [640, 960, 1280])}
              sizes={imageSizes}
            />
            <img
              src={siteData.media.exterior}
              alt={copy.visit.imageAlt}
              loading="lazy"
              width="1439"
              height="960"
            />
          </picture>
        </figure>

        <div class="visit-content">
          <div class="visit-details">
            <div class="visit-detail">
              <span>{copy.visit.addressLabel}</span>
              <strong>{siteData.company.address}</strong>
              <p>{siteData.company.postalCode} {siteData.company.city}, {locale === 'ro' ? 'România' : 'Romania'}</p>
            </div>
            <div class="visit-detail">
              <span>{copy.visit.phoneLabel}</span>
              <a href={siteData.company.phoneHref}>{siteData.company.phone}</a>
            </div>
            <div class="visit-detail visit-hours">
              <span>{copy.visit.hoursLabel}</span>
              {openingHours.map((hours) => <p>{hours}</p>)}
            </div>
            <a class="button button-outline" href={siteData.links.map} target="_blank" rel="noreferrer">
              {copy.visit.mapAction}<Icon name="location" size={18} />
            </a>
            <a class="button button-outline" href={siteData.links.googleBusiness} target="_blank" rel="noreferrer">
              {copy.visit.reviewsAction}<Icon name="diagonal" size={18} />
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer {locale} />
  <a class="mobile-booking-cta" href={siteData.company.phoneHref}>
    {copy.hero.primaryAction}<Icon name="phone" size={18} />
  </a>
</BaseLayout>
