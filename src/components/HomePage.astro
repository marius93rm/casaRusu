---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import MenuPreview from './MenuPreview.astro';
import OpeningStatus from './OpeningStatus.astro';
import RestaurantPhoto from './RestaurantPhoto.astro';
import PhotoGallery from './PhotoGallery.astro';
import { menuCopy, menuPages } from '../data/menu';
import { siteData, type SiteLocale } from '../data/site';
import { getDictionary, localizedPath } from '../i18n';
import { formatOpeningHours } from '../utils/openingHours';

const { locale } = Astro.props as { locale: SiteLocale };
const copy = siteData.copy[locale];
const { ui } = getDictionary(locale);
const seo = siteData.seo[locale];
const socialImage = {
  src: siteData.media.cover,
  alt: copy.hero.imageAlt,
  width: 2048,
  height: 1366,
};
const dishHref = localizedPath('/preparate/snitel-cotlet-porc', locale);
const openingHours = formatOpeningHours(siteData.company.openingHours, locale);
const menuPriceCategories = [
  { pageId: 'aperitive', sectionIndex: 0 },
  { pageId: 'salate-ciorbe', sectionIndex: 1 },
  { pageId: 'paste-peste', sectionIndex: 0 },
  { pageId: 'paste-peste', sectionIndex: 1 },
].map(({ pageId, sectionIndex }) => {
  const page = menuPages.find((candidate) => candidate.id === pageId);
  const section = page?.sections[sectionIndex];
  if (!page || !section || section.items.length === 0) {
    throw new Error(`Missing homepage price category: ${pageId}-${sectionIndex + 1}`);
  }

  return {
    label: section.title[locale],
    price: Math.min(...section.items.map((item) => item.price)),
    href: `${localizedPath('/meniu', locale)}/?category=${page.id}-${sectionIndex + 1}#read-menu`,
  };
});
const menuPrices = menuPages.flatMap((page) => page.sections.flatMap((section) => section.items.map((item) => item.price)));
const menuPriceRange = `${Math.min(...menuPrices)}–${Math.max(...menuPrices)} lei`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: siteData.company.name,
  telephone: siteData.company.phone,
  acceptsReservations: true,
  servesCuisine: siteData.company.cuisines,
  priceRange: menuPriceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteData.company.address,
    addressLocality: siteData.company.city,
    postalCode: siteData.company.postalCode,
    addressCountry: 'RO',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteData.company.geo.latitude,
    longitude: siteData.company.geo.longitude,
  },
  hasMap: siteData.links.googleBusiness,
  openingHoursSpecification: siteData.company.openingHours.map((hours) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: hours.daysOfWeek.map((day) => `https://schema.org/${day}`),
    opens: hours.opens,
    closes: hours.closes,
  })),
  sameAs: [siteData.links.facebook, siteData.links.instagram, siteData.links.tiktok, siteData.links.googleBusiness],
  ...(Astro.site ? {
    '@id': new URL('/#restaurant', Astro.site).toString(),
    url: new URL('/', Astro.site).toString(),
    image: [siteData.media.cover, siteData.media.exterior, siteData.media.featuredDish]
      .map((image) => new URL(image, Astro.site).toString()),
    logo: new URL(siteData.media.logo, Astro.site).toString(),
    menu: new URL(`${localizedPath('/meniu', locale)}/`, Astro.site).toString(),
  } : {}),
};
---

<BaseLayout lang={locale} title={seo.title} description={seo.description} {socialImage}
  criticalImage={{ srcset: `${siteData.media.cover} 2048w`, sizes: '100vw', type: 'image/jpeg' }}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <a class="skip-link" href="#main-content">{ui.skipToContent}</a>
  <Header {locale} navigation={copy.nav} cta={{ label: copy.hero.primaryAction, href: siteData.company.phoneHref }} />

  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-stage">
        <div class="hero-copy">
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <h1 id="hero-title">{copy.hero.title}</h1>
          <p class="hero-slogan">{copy.hero.slogan}</p>
          <p class="hero-description">{copy.hero.description}</p>
          <OpeningStatus {locale} />
          <div class="hero-actions">
            <a class="button button-primary" href={siteData.company.phoneHref} data-booking-primary>
              {copy.hero.primaryAction}<Icon name="phone" size={18} />
            </a>
            <a class="button button-outline" href={`${localizedPath('/meniu', locale)}/`}>
              {menuCopy[locale].action}<Icon name="arrow" size={18} />
            </a>
            <a class="text-link" href="#vizita">{copy.hero.secondaryAction}<Icon name="diagonal" size={17} /></a>
          </div>
        </div>

        <figure class="hero-visual">
          <RestaurantPhoto image={siteData.media.cover} alt={copy.hero.imageAlt} eager />
        </figure>
      </div>
    </section>

    <section class="story-section" id="poveste" tabindex="-1" aria-labelledby="story-title">
      <div class="container story-inner">
        <h2 id="story-title">{copy.story.title}</h2>
        <p class="story-body">{copy.story.body}</p>
        <p class="story-price-note">{copy.story.priceGuide}</p>
        <ul class="story-price-grid" aria-label={copy.story.priceGuide}>
          {menuPriceCategories.map((category) => (
            <li>
              <a class="story-price-card" href={category.href}>
                <span class="story-price-category">{category.label}</span>
                <span class="story-price-value">{copy.story.priceFrom.replace('{price}', String(category.price))}</span>
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))}
        </ul>
        <a class="text-link story-link" href="#preparat">{copy.dish.eyebrow}<Icon name="arrow" size={18} /></a>
      </div>
    </section>

    <MenuPreview {locale} />

    <section class="dish-section" id="preparat" tabindex="-1" aria-labelledby="dish-title">
      <div class="container dish-grid">
        <figure class="dish-visual">
          <RestaurantPhoto image={siteData.media.featuredDish} alt={copy.dish.imageAlt} />
        </figure>
        <div class="dish-copy">
          <p class="section-label">{copy.dish.eyebrow}</p>
          <h2 id="dish-title">{copy.dish.title}</h2>
          <p>{copy.dish.body}</p>
          <small>{copy.dish.note}</small>
          <a class="text-link" href={dishHref}>
            {copy.dish.action}<Icon name="diagonal" size={17} />
          </a>
        </div>
      </div>
    </section>

    <PhotoGallery {locale} />

    <section class="visit-section" id="vizita" tabindex="-1" aria-labelledby="visit-title">
      <div class="container visit-layout">
        <div class="visit-heading">
          <h2 id="visit-title">{copy.visit.titleFirst}{' '}<span>{copy.visit.titleSecond}</span></h2>
          <p>{copy.visit.body}</p>
        </div>
        <figure class="visit-visual">
          <RestaurantPhoto image={siteData.media.exterior} alt={copy.visit.imageAlt} />
        </figure>

        <div class="visit-content">
          <div class="visit-details">
            <div class="visit-detail">
              <span>{copy.visit.addressLabel}</span>
              <strong>{siteData.company.address}</strong>
              <p>{siteData.company.postalCode} {siteData.company.city}, {ui.country}</p>
              <button
                class="text-link visit-copy-address"
                type="button"
                data-copy-address
                data-address={`${siteData.company.address}, ${siteData.company.postalCode} ${siteData.company.city}, ${ui.country}`}
                data-copy-success={copy.visit.addressCopied}
                data-copy-error={copy.visit.addressCopyFailed}
                aria-describedby="visit-copy-address-status"
              >{copy.visit.copyAddress}</button>
              <p class="visit-copy-address-status" id="visit-copy-address-status" data-copy-address-status role="status" aria-live="polite" aria-atomic="true" hidden></p>
            </div>
            <div class="visit-detail">
              <span>{copy.visit.phoneLabel}</span>
              <a href={siteData.company.phoneHref}>{siteData.company.phone}</a>
            </div>
            <div class="visit-detail visit-hours">
              <span>{copy.visit.hoursLabel}</span>
              {openingHours.map((hours) => <p>{hours}</p>)}
            </div>
            <a class="button button-outline" href={siteData.links.map} target="_blank" rel="noreferrer" aria-describedby="external-link-new-tab" data-map-directions>
              {copy.visit.mapAction}<Icon name="location" size={18} />
            </a>
            <a class="button button-outline" href={siteData.links.googleBusiness} target="_blank" rel="noreferrer" aria-describedby="external-link-new-tab">
              {copy.visit.reviewsAction}<Icon name="diagonal" size={18} />
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer {locale} />
  <aside class="mobile-booking" aria-label={ui.reservations} data-mobile-booking hidden>
    <a class="mobile-booking-cta" href={siteData.company.phoneHref}>
      {copy.hero.primaryAction}<Icon name="phone" size={18} />
    </a>
  </aside>
</BaseLayout>

<script is:inline>
  (() => {
    const copyAddressButton = document.querySelector('[data-copy-address]');
    const copyAddressStatus = document.querySelector('[data-copy-address-status]');
    if (copyAddressButton instanceof HTMLButtonElement && copyAddressStatus instanceof HTMLParagraphElement) {
      copyAddressButton.addEventListener('click', async () => {
        const address = copyAddressButton.dataset.address?.trim();
        try {
          if (!address || typeof navigator.clipboard?.writeText !== 'function') throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(address);
          copyAddressStatus.textContent = copyAddressButton.dataset.copySuccess ?? '';
        } catch {
          copyAddressStatus.textContent = copyAddressButton.dataset.copyError ?? '';
        }
        copyAddressStatus.hidden = false;
      });
    }

    const mobileBooking = document.querySelector('[data-mobile-booking]');
    const primaryBooking = document.querySelector('[data-booking-primary]');
    const visitPhoto = document.querySelector('.visit-visual');
    const visitActions = [...document.querySelectorAll('.visit-details a, .visit-details button')];
    if (!(mobileBooking instanceof HTMLElement) || !(primaryBooking instanceof HTMLAnchorElement)) return;
    const mobileBookingCta = mobileBooking.querySelector('.mobile-booking-cta');

    const mobileViewport = window.matchMedia('(max-width: 760px)');
    const rootFontSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    let syncFrame = 0;
    const measureBookingBarHeight = () => {
      if (!mobileViewport.matches || !(mobileBookingCta instanceof HTMLElement)) return 0;
      const measurement = mobileBookingCta.cloneNode(true);
      measurement.removeAttribute('href');
      measurement.setAttribute('aria-hidden', 'true');
      measurement.setAttribute('inert', '');
      measurement.tabIndex = -1;
      measurement.style.setProperty('visibility', 'hidden', 'important');
      measurement.style.setProperty('pointer-events', 'none', 'important');
      document.body.appendChild(measurement);
      const height = measurement.getBoundingClientRect().height;
      measurement.remove();
      return height || rootFontSize * 4;
    };
    let bookingBarHeight = measureBookingBarHeight();
    const syncMobileBooking = () => {
      const rect = primaryBooking.getBoundingClientRect();
      const bookingBarTop = window.innerHeight - bookingBarHeight;
      const visibleAboveBookingBar = rect.bottom > rootFontSize * 5
        && rect.top < bookingBarTop
        && rect.right > 0
        && rect.left < window.innerWidth;
      const visitPhotoRect = visitPhoto instanceof HTMLElement ? visitPhoto.getBoundingClientRect() : null;
      const visitPhotoOverlapsBookingBar = visitPhotoRect !== null
        && visitPhotoRect.bottom > bookingBarTop
        && visitPhotoRect.top < window.innerHeight;
      const visitActionOverlapsBookingBar = visitActions.some((action) => {
        const actionRect = action.getBoundingClientRect();
        return actionRect.bottom > bookingBarTop
          && actionRect.top < window.innerHeight
          && actionRect.right > 0
          && actionRect.left < window.innerWidth;
      });
      const shouldHide = mobileViewport.matches
        && (visibleAboveBookingBar || visitPhotoOverlapsBookingBar || visitActionOverlapsBookingBar)
        && !mobileBooking.contains(document.activeElement);
      mobileBooking.hidden = shouldHide;
    };
    const scheduleSync = () => {
      if (syncFrame) return;
      syncFrame = window.requestAnimationFrame(() => {
        syncFrame = 0;
        syncMobileBooking();
      });
    };

    window.addEventListener('scroll', scheduleSync, { passive: true });
    window.addEventListener('resize', () => {
      bookingBarHeight = measureBookingBarHeight();
      scheduleSync();
    }, { passive: true });
    document.addEventListener('keydown', scheduleSync);
    document.addEventListener('focusin', scheduleSync);
    document.addEventListener('focusout', scheduleSync, true);
    mobileViewport.addEventListener('change', () => {
      bookingBarHeight = measureBookingBarHeight();
      scheduleSync();
    });
    syncMobileBooking();
  })();
</script>
