---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import MenuGallery from './MenuGallery.astro';
import MenuTranscript from './MenuTranscript.astro';
import { menuCopy } from '../data/menu';
import { siteData, type SiteLocale } from '../data/site';
import { localizedPath } from '../i18n';
import { imageSizes, webpSrcset } from '../utils/responsiveImages';

const { locale } = Astro.props as { locale: SiteLocale };
const copy = siteData.copy[locale];
const menu = menuCopy[locale];
const offer = copy.menu.offer;
const offerActive = Date.now() < Date.parse(siteData.promotions.cocktailOffer.expiresAt);
const socialImage = {
  src: siteData.media.featuredDish,
  alt: copy.dish.imageAlt,
  width: 2048,
  height: 1366,
};
const dishHref = localizedPath('/preparate/snitel-cotlet-porc', locale);
---

<BaseLayout
  lang={locale}
  title={copy.menu.seo.title}
  description={copy.menu.seo.description}
  {socialImage}
>
  <a class="skip-link" href="#main-content">{locale === 'ro' ? 'Sari la conținut' : 'Skip to content'}</a>
  <Header {locale} navigation={copy.nav} cta={{ label: copy.hero.primaryAction, href: siteData.company.phoneHref }} />

  <main id="main-content" tabindex="-1">
    <section class="menu-page" aria-labelledby="menu-page-title">
      <div class="container">
        <Breadcrumbs locale={locale} currentLabel={copy.menu.eyebrow} level="menu" />
        <header class="menu-page-heading">
          <p class="eyebrow">{copy.menu.eyebrow}</p>
          <h1 id="menu-page-title">{copy.menu.title}</h1>
          <p class="menu-page-intro">{copy.menu.body}</p>
        </header>

        <MenuGallery {locale} />
        <MenuTranscript {locale} />

        <header class="menu-extras-heading">
          <p class="eyebrow">{menu.extras}</p>
          <h2>{menu.extrasTitle}</h2>
        </header>
        <article class="menu-feature">
          <a class="menu-feature-visual" href={dishHref} aria-label={`${copy.menu.dishAction}: ${copy.dish.title}`}>
            <picture>
              <source
                type="image/webp"
                srcset={webpSrcset(siteData.media.featuredDish, [640, 960, 1280, 1600, 1920])}
                sizes={imageSizes}
              />
              <img
                src={siteData.media.featuredDish}
                alt={copy.dish.imageAlt}
                loading="lazy"
                width="2048"
                height="1366"
              />
            </picture>
          </a>

          <div class="menu-feature-copy">
            <p class="section-label">{copy.dish.eyebrow}</p>
            <h3><a href={dishHref}>{copy.dish.title}</a></h3>
            <p class="menu-feature-description">{copy.dish.body}</p>
            <p class="menu-feature-note">{copy.dish.note}</p>
            <a class="text-link" href={dishHref}>
              {copy.menu.dishAction}<Icon name="diagonal" size={17} />
            </a>
          </div>
        </article>

        {offerActive && (
          <section
            class="menu-offer"
            aria-labelledby="menu-offer-title"
            data-expires-at={siteData.promotions.cocktailOffer.expiresAt}
          >
            <header>
              <p class="eyebrow">{offer.eyebrow}</p>
              <h2 id="menu-offer-title">{offer.title}</h2>
            </header>
            <p class="menu-offer-copy">{offer.body}</p>
            <ul class="menu-offer-cocktails">
              {offer.cocktails.map((cocktail) => <li>{cocktail}</li>)}
            </ul>
            <div class="menu-offer-actions">
              <a class="button button-primary" href={siteData.company.phoneHref}>
                {offer.callAction}<Icon name="phone" size={18} />
              </a>
              <a class="text-link" href={siteData.promotions.cocktailOffer.sourceUrl} target="_blank" rel="noopener noreferrer">
                {offer.sourceAction}<Icon name="diagonal" size={17} />
              </a>
            </div>
          </section>
        )}
      </div>
    </section>
  </main>

  <Footer {locale} />
  <aside class="mobile-booking" aria-label={locale === 'ro' ? 'Rezervări' : 'Reservations'}>
    <a class="mobile-booking-cta" href={siteData.company.phoneHref}>
      {copy.hero.primaryAction}<Icon name="phone" size={18} />
    </a>
  </aside>
</BaseLayout>

<script>
  const offer = document.querySelector<HTMLElement>('.menu-offer[data-expires-at]');
  if (offer) {
    const expiresAt = Date.parse(offer.dataset.expiresAt ?? '');
    if (Number.isFinite(expiresAt) && Date.now() >= expiresAt) offer.remove();
  }
</script>
