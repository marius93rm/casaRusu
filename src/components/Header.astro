---
import Brand from './Brand.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon from './Icon.astro';
import { getDictionary, localizedPath, type Locale } from '../i18n';

export interface NavigationItem {
  label: string;
  href: string;
}

interface Props {
  locale: Locale;
  navigation?: readonly NavigationItem[];
  cta?: NavigationItem;
}

const { locale, navigation = [], cta } = Astro.props;
const dictionary = getDictionary(locale);
const homeHref = localizedPath('/', locale);
---

<header class="site-header">
  <div class="container header-inner">
    <Brand href={homeHref} />

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      aria-label={dictionary.ui.menu}
      data-open-label={dictionary.ui.menu}
      data-close-label={dictionary.ui.closeMenu}
      hidden
    >
      <span class="menu-toggle-open"><Icon name="menu" /></span>
      <span class="menu-toggle-close"><Icon name="close" /></span>
    </button>

    <nav id="main-navigation" class="main-navigation" aria-label={dictionary.ui.mainNavigation}>
      {navigation.length > 0 && (
        <ul>
          {navigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      )}

      <div class="header-actions">
        <LanguageSwitcher {locale} />
        {cta && <a class="header-cta" href={cta.href}>{cta.label}</a>}
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector('.menu-toggle');
    const nav = document.querySelector('#main-navigation');
    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? toggle.dataset.closeLabel || '' : toggle.dataset.openLabel || '');
      nav.dataset.open = String(open);
    };

    nav.dataset.enhanced = 'true';
    const desktop = window.matchMedia('(min-width: 761px)');
    const syncViewport = () => {
      toggle.hidden = desktop.matches;
      setOpen(false);
    };
    syncViewport();

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    desktop.addEventListener('change', syncViewport);
  })();
</script>
