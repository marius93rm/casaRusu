---
import { menuSrcset, type MenuPage } from '../data/menu';
import type { SiteLocale } from '../data/site';
interface Props { page: MenuPage; index: number; locale: SiteLocale; pageLabel: string; enlargeLabel: string; }
const { page, index, locale, pageLabel, enlargeLabel } = Astro.props;
const sizes = '(max-width: 760px) calc(100vw - 2.5rem), (max-width: 1100px) 55vw, 550px';
---
<picture>
  {index === 0 && <source type="image/avif" srcset={menuSrcset(page, 'avif')} {sizes} />}
  <source type="image/webp" srcset={menuSrcset(page)} {sizes} />
  <img src={`/images/menu/${page.id}-800.webp`} alt={`${pageLabel} ${index + 1}: ${page.title[locale]}. ${enlargeLabel}.`}
    width={page.width} height={page.height} loading={index === 0 ? 'eager' : 'lazy'}
    fetchpriority={index === 0 ? 'high' : 'low'} decoding="async" />
</picture>
