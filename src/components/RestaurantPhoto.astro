---

import { imageSizes, imageSrcset, restaurantAvifWidths, restaurantWebpWidths } from '../utils/responsiveImages';

interface Props {
  image: string;
  alt: string;
  eager?: boolean;
  responsive?: boolean;
  sizes?: string;
}

const { image, alt, eager = false, responsive = false, sizes = imageSizes } = Astro.props;
const sources = responsive ? [
  { type: 'image/avif', srcset: imageSrcset(image, restaurantAvifWidths, 'avif') },
  { type: 'image/webp', srcset: imageSrcset(image, restaurantWebpWidths, 'webp') },
] : [];
---

<!-- Prefer existing responsive AVIF/WebP files and keep the original JPEG as fallback. -->
<picture data-responsive-photo={responsive ? 'true' : undefined}>
  {sources.map((source) => <source type={source.type} srcset={source.srcset} sizes={responsive ? sizes : undefined} />)}
  <img
    src={image}
    {alt}
    width="2048"
    height="1366"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'low'}
    decoding="async"
  />
</picture>
