---
import { siteData, type SiteLocale } from '../data/site';
import BrandMark from './BrandMark.astro';

interface Props {
  href?: string;
  label?: string;
  locale?: SiteLocale;
}

const { href = '/', locale = 'ro', label = `${siteData.company.name} — ${locale === 'en' ? 'Home' : 'Acasă'}` } = Astro.props;
---

<a class="brand" {href} aria-label={label}>
  <BrandMark />
  <span class="brand-lettering" aria-hidden="true">
    <span class="brand-name">Casa Rusu</span>
    <span class="brand-descriptor">Restaurant</span>
  </span>
</a>
