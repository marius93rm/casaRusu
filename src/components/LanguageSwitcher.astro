---
import { getDictionary, locales, switchLocalePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
---

<nav class="language-switcher" aria-label={dictionary.ui.languageSwitcher}>
  {locales.map((targetLocale) => {
    const target = getDictionary(targetLocale);
    return (
      <a
        href={switchLocalePath(Astro.url, targetLocale)}
        lang={targetLocale}
        aria-current={targetLocale === locale ? 'page' : undefined}
      >
        {target.languageName}
      </a>
    );
  })}
</nav>

<style>
  .language-switcher {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .language-switcher a {
    text-decoration: none;
  }

  .language-switcher a[aria-current='page'] {
    font-weight: 700;
  }
</style>
