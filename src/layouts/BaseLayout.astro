---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import type { SiteLocale } from '../data/site';
import { locales, socialLocales, switchLocalePath } from '../i18n';
import Motion from '../components/Motion.astro';
import LanguageDetection from '../components/LanguageDetection.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: SiteLocale;
  criticalImage?: { srcset: string; sizes: string; type: 'image/avif' | 'image/webp' };
  socialImage?: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
  noIndex?: boolean;
  detectLanguage?: boolean;
}

const {
  title = siteConfig.seo.title,
  description = siteConfig.seo.description,
  lang = 'ro',
  socialImage: socialImageData,
  criticalImage,
  noIndex = false,
  detectLanguage = true,
} = Astro.props;

const theme = siteConfig.branding.theme;
const themeStyle = [
  `--background:${theme.background}`,
  `--surface:${theme.surface}`,
  `--text:${theme.text}`,
  `--muted:${theme.muted}`,
  `--primary:${theme.primary}`,
  `--accent:${theme.accent}`,
  `--border:${theme.border}`,
].join(';');
const canonicalUrl = Astro.site && !noIndex ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const localizedUrl = (locale: SiteLocale) => {
  if (!Astro.site) return undefined;
  const path = switchLocalePath(new URL(Astro.url.pathname, Astro.url), locale);
  return new URL(path === '/' || path.endsWith('/') ? path : `${path}/`, Astro.site).toString();
};
const romanianUrl = localizedUrl('ro');
const socialImageUrl = Astro.site && socialImageData
  ? new URL(socialImageData.src, Astro.site).toString()
  : undefined;
const socialLocale = socialLocales[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    {detectLanguage && <LanguageDetection />}
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {criticalImage && <link rel="preload" as="image" type={criticalImage.type} imagesrcset={criticalImage.srcset} imagesizes={criticalImage.sizes} fetchpriority="high" />}
    <meta name="theme-color" content={theme.background} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#211e1a" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/optimized/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    {lang === 'ro' && <link rel="preload" href="/fonts/optimized/dm-sans-latin-ext.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href="/fonts/optimized/cormorant-garamond-latin.woff2" as="font" type="font/woff2" crossorigin />
    {lang === 'ro' && <link rel="preload" href="/fonts/optimized/cormorant-garamond-latin-ext.woff2" as="font" type="font/woff2" crossorigin />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Restaurant Casa Rusu" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content={socialLocale} />
    {locales.filter((locale) => locale !== lang).map((locale) => <meta property="og:locale:alternate" content={socialLocales[locale]} />)}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && socialImageData && <meta property="og:image:alt" content={socialImageData.alt} />}
    {socialImageUrl && socialImageData && <meta property="og:image:width" content={String(socialImageData.width)} />}
    {socialImageUrl && socialImageData && <meta property="og:image:height" content={String(socialImageData.height)} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImageUrl && socialImageData && <meta name="twitter:image:alt" content={socialImageData.alt} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {!noIndex && Astro.site && locales.map((locale) => <link rel="alternate" hreflang={locale === 'ro' ? 'ro-RO' : locale} href={localizedUrl(locale)} />)}
    {!noIndex && romanianUrl && <link rel="alternate" hreflang="x-default" href={romanianUrl} />}
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    {(!siteConfig.seo.indexable || noIndex) && <meta name="robots" content="noindex,nofollow" />}
  </head>
  <body style={themeStyle}>
    <slot />
    <Motion />
  </body>
</html>
