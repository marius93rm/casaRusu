{
  "name": "casa-rusu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "optimize:gallery": "node scripts/optimize-gallery.mjs",
    "optimize:photos": "node scripts/optimize-photos.mjs",
    "optimize:fonts": "python scripts/optimize-fonts.py",
    "optimize:social": "node scripts/optimize-social-images.mjs",
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro check && astro build && npm run check:seo && npm run check:menu && npm run check:hours && npm run check:gallery && npm run check:i18n && npm run check:docs",
    "check:hours": "node scripts/check-opening-status.mjs",
    "check:gallery": "node scripts/check-photo-gallery.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:menu": "node scripts/check-menu.mjs",
    "check:docs": "node scripts/check-project-docs.mjs",
    "format:check": "node scripts/check-format.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/check-language-detection.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tabler/icons-astro": "^3.47.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "axe-core": "4.14.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "^0.35.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
